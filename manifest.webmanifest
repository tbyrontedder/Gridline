{
  "name": "Gridline",
  "short_name": "Gridline",
  "description": "A local-first spreadsheet for Excel and CSV files.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#176b4a",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ],
  "launch_handler": {
    "client_mode": "navigate-new"
  },
  "file_handlers": [
    {
      "action": "./?open-file",
      "accept": {
        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": [
          ".xlsx"
        ],
        "text/csv": [
          ".csv"
        ],
        "text/tab-separated-values": [
          ".tsv"
        ],
        "application/json": [
          ".gridline"
        ]
      },
      "launch_type": "multiple-clients"
    }
  ]
}
